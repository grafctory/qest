    "abnf",
    "cddl"
  ],
  "externalSymbolLinkMappings": {
    "@grafctory/core": {
      "isIdentifier": "https://grafctory.github.io/core/functions/index.isIdentifier.html",
      "Identifier": "https://grafctory.github.io/core/types/index.Identifier.html",
      "Optional": "https://grafctory.github.io/core/types/index.Optional.html",
      "Guard": "https://grafctory.github.io/core/types/index.Guard.html",
      "IRI": "https://grafctory.github.io/core/types/resource.IRI.html",
      "base": "https://grafctory.github.io/core/variables/resource.base.html",
      "internalize": "https://grafctory.github.io/core/functions/resource.internalize.html",
      "resolve": "https://grafctory.github.io/core/functions/resource.resolve.html",
      "Tag": "https://grafctory.github.io/core/types/language.Tag.html",
      "TagRange": "https://grafctory.github.io/core/types/language.TagRange.html",
      "immutable": "https://grafctory.github.io/core/functions/values.immutable.html"
