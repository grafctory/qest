{
  "name": "@grafctory/qest",
  "version": "0.15.2",
  "description": "Foundations for client-driven, queryable REST/JSON APIs.",
  "keywords": [
    "typescript",
    "json-ld",
    "rest-json",
    "query",
    "api"
  ],
  "homepage": "https://grafctory.github.io/qest/",
  "bugs": {
    "url": "https://github.com/grafctory/qest/issues",
    "email": "info@grafctory.dev"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/qest.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./state": {
      "@grafctory/source": "./src/state.ts",
      "default": "./dist/state.js"
    },
    "./model": {
      "@grafctory/source": "./src/model.ts",
      "default": "./dist/model.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules 'src/*.pegjs.*'",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "peggy": "npx peggy --dts --format es --allowed-start-rules '*' --output src/model.pegjs.js src/model.pegjs",
    "build": "ush rm dist docs && npm run peggy && tsc -p tsconfig.build.json && ush cp dist 'src/*.pegjs.*' && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "ush up npx typedoc --watch + ush ws --open docs"
  },
  "dependencies": {
    "@grafctory/core": "^0.14.0"
  },
  "devDependencies": {
    "@grafctory/rack": "^0.8.0",
    "peggy": "^4.1.3",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vitest": "^4.0.14"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
